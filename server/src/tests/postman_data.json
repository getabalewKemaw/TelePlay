{
    "info": {
        "name": "I-Player API Test Data",
        "description": "JSON payloads for testing the I-Player Backend API"
    },
    "endpoints": {
        "ffmpeg": {
            "decode_g711": {
                "method": "POST",
                "url": "/api/ffmpeg/decode",
                "payload": {
                    "input": {
                        "path": "uploads/audio.g711",
                        "format": "mulaw"
                    },
                    "output": {
                        "path": "processed/audio_g711.wav",
                        "format": "wav"
                    },
                    "codec": "g711",
                    "sampleRate": 8000,
                    "channels": 1
                }
            },
            "decode_g726": {
                "method": "POST",
                "url": "/api/ffmpeg/decode",
                "payload": {
                    "input": {
                        "path": "uploads/audio.g726",
                        "format": "g726"
                    },
                    "output": {
                        "path": "processed/audio_g726.wav",
                        "format": "wav"
                    },
                    "codec": "g726",
                    "sampleRate": 8000,
                    "channels": 1,
                    "bitrate": 32
                }
            },
            "decode_g728": {
                "method": "POST",
                "url": "/api/ffmpeg/decode",
                "payload": {
                    "input": {
                        "path": "uploads/audio.g728",
                        "format": "g728"
                    },
                    "output": {
                        "path": "processed/audio_g728.wav",
                        "format": "wav"
                    },
                    "codec": "g728",
                    "sampleRate": 16000,
                    "channels": 1
                }
            }
        },
        "compression": {
            "compress": {
                "method": "POST",
                "url": "/api/compress",
                "payload": {
                    "inputPath": "processed/audio.wav",
                    "options": {
                        "level": "medium",
                        "preset": "balanced"
                    }
                }
            }
        },
        "streaming": {
            "createSession": {
                "method": "POST",
                "url": "/api/streaming/sessions",
                "payload": {
                    "filePath": "processed/audio.wav",
                    "options": {
                        "transport": "http",
                        "mode": "file-based",
                        "preTranscode": true
                    }
                }
            },
            "playback": {
                "method": "POST",
                "url": "/api/streaming/sessions/{{sessionId}}/playback",
                "payload": {
                    "action": "seek",
                    "targetTime": 45.5
                }
            }
        },
        "error_example": {
            "description": "Trigger a validation error",
            "payload": {
                "input": {
                    "path": ""
                }
            }
        }
    }
}
